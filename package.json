{
  "name": "auth_app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "yarn dev:vite && yarn dev:server",
    "dev:vite": "vite build --mode development",
    "dev:server": "tsc -p tsconfig.server.json && node dist/server.js",
    "build:staging": "vite build --mode staging && tsc -p tsconfig.server.json",
    "build:production": "vite build --mode production && tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "preview": "vite preview",
    "docker:build": "docker build -f Dockerfile.prod -t auth_app:prod .",
    "docker:run": "docker run -p 3000:3000 auth_app:prod",
    "reinstall": "make clean && npm install",
    "clean": "rm -rf node_modules .vite dist"
  },
  "dependencies": {
    "axios": "^0.24.0",
    "express": "^4.18.2",
    "jwt-decode": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.5.4",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-istanbul": "2.1.3",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "jest": "^29.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^2.8.0",
    "tsx": "^4.19.1",
    "typescript": "^4.9.5",
    "vite": "^4.2.0",
    "vitest": "^2.1.3"
  }
}
